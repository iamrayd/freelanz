# Copy to .env.local and fill in. Never commit real values.
# Validated by src/env/schema.ts. Empty values are treated as unset.
# Everything is optional until the story in brackets makes it required.

# Postgres connection string. Neon dashboard > project > Connection Details
# (use the dev branch locally), or a local Postgres URL. [FLZ-11]
DATABASE_URL=

# Auth.js secret. Generate with `npx auth secret` or `openssl rand -base64 32`. [FLZ-20]
AUTH_SECRET=

# GitHub OAuth app: github.com/settings/developers > OAuth Apps.
# Callback URL: <NEXT_PUBLIC_APP_URL>/api/auth/callback/github [FLZ-20]
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client: console.cloud.google.com > APIs & Services > Credentials.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google [FLZ-20]
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bearer token Vercel Cron sends to /api/cron/ingest. At least 32 characters.
# Generate with `openssl rand -hex 32`; set the same value in Vercel project env. [FLZ-14]
CRON_SECRET=

# Public base URL of the app. Defaults to http://localhost:3000.
# In Vercel set it to the deployment's domain.
NEXT_PUBLIC_APP_URL=

# Set to 1 to skip env validation (CI builds without secrets). Do not use locally.
# SKIP_ENV_VALIDATION=1
